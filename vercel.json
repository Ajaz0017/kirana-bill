{
  "functions": {
    "api/scan.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/s/:slug",
      "destination": "/shop.html"
    },
    {
      "source": "/o/:code",
      "destination": "/shop.html"
    },
    {
      "source": "/orders",
      "destination": "/shop.html"
    }
  ]
}
