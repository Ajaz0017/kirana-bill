# Long random secret that signs the login cookie. Generate with:  openssl rand -hex 32
# (changing it logs everyone out)
AUTH_SECRET=

# Neon Postgres. On Vercel: Storage → Create Database → Neon → connect to this project
# (Vercel adds DATABASE_URL itself). Locally: copy the same connection string here.
DATABASE_URL=

# Optional: if set, people need this code to create an account (stops strangers signing up
# and using your scan quota). Leave empty for open signup.
SIGNUP_CODE=

# Copy to .env (local) / add in Vercel → Project → Settings → Environment Variables

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional; "gemini-flash-latest" always points at the current Flash model
GEMINI_MODEL=gemini-flash-latest
# Tried when the main model is busy (503) or fails
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Optional free fallback when Gemini's daily limit runs out: https://z.ai (Zhipu GLM)
GLM_API_KEY=
GLM_MODEL=glm-4.6v-flash
