# App lock: PIN people type to open the app (6+ digits recommended), and a long random
# secret that signs the login cookie. Generate the secret with:  openssl rand -hex 32
APP_PIN=
AUTH_SECRET=

# Copy to .env (local) / add in Vercel → Project → Settings → Environment Variables

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional; "gemini-flash-latest" always points at the current Flash model
GEMINI_MODEL=gemini-flash-latest
# Tried when the main model is busy (503) or fails
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Optional free fallback when Gemini's daily limit runs out: https://z.ai (Zhipu GLM)
GLM_API_KEY=
GLM_MODEL=glm-4.6v-flash
